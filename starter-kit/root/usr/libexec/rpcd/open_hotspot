#!/bin/sh
# rpcd plugin for the local Open-HotSpot management boundary.
# JSON is carried over stdin; secrets are never command-line arguments.

. /usr/share/libubox/jshn.sh

ADMIN=/usr/lib/open-hotspot/admin.sh
NDS_HELPER=/usr/lib/open-hotspot/opennds.sh
TEMPLATE_HELPER=/usr/lib/open-hotspot/template.sh

rpc_error() {
	json_init
	json_add_boolean ok 0
	json_add_string error "$1"
	json_dump
	exit 1
}

rpc_ok() {
	json_init
	json_add_boolean ok 1
	json_dump
}

rpc_profile_list() {
	rows=$($ADMIN profile-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array profiles
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	while read -r id name period time_limit upload_limit download_limit upload_rate download_rate max_devices; do
		[ -n "$id" ] || continue
		json_add_object
		json_add_int id "$id"
		json_add_string name "$name"
		json_add_string period_type "$period"
		json_add_int time_limit_s "$time_limit"
		json_add_int upload_limit_b "$upload_limit"
		json_add_int download_limit_b "$download_limit"
		json_add_int upload_rate_kbps "$upload_rate"
		json_add_int download_rate_kbps "$download_rate"
		json_add_int max_devices "$max_devices"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_account_list() {
	rows=$($ADMIN account-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array accounts
	old_ifs="$IFS"
	IFS="$(printf '\t')"
	while read -r id username profile_id profile_name status expires_at; do
		[ -n "$id" ] || continue
		json_add_object
		json_add_int id "$id"
		json_add_string username "$username"
		json_add_int profile_id "$profile_id"
		json_add_string profile_name "$profile_name"
		json_add_string status "$status"
		json_add_string expires_at "${expires_at:-}"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_device_list() {
	rows=$($ADMIN device-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array devices
	old_ifs="$IFS"
	IFS='|'
	while read -r id account_id username mac status first_seen last_seen live_sessions; do
		[ -n "$id" ] || continue
		json_add_object
		json_add_int id "$id"
		json_add_int account_id "$account_id"
		json_add_string username "$username"
		json_add_string mac "$mac"
		json_add_string status "$status"
		json_add_string first_seen "$first_seen"
		json_add_string last_seen "${last_seen:-}"
		json_add_int live_sessions "$live_sessions"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_voucher_list() {
	rows=$($ADMIN voucher-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array vouchers
	old_ifs="$IFS"
	IFS='|'
	while read -r id code profile_id profile_name validity_seconds status redeemed_by redeemed_at expires_at; do
		[ -n "$id" ] || continue
		json_add_object
		json_add_int id "$id"
		json_add_string code "$code"
		json_add_int profile_id "$profile_id"
		json_add_string profile_name "$profile_name"
		json_add_int validity_seconds "$validity_seconds"
		json_add_string status "$status"
		json_add_string redeemed_by "${redeemed_by:-}"
		json_add_string redeemed_at "${redeemed_at:-}"
		json_add_string expires_at "${expires_at:-}"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_overview() {
	row=$($ADMIN overview 2>/dev/null) || rpc_error database
	old_ifs="$IFS"
	IFS='|'
	read -r active_accounts active_sessions seconds_used bytes_up bytes_down <<EOF
$row
EOF
	IFS="$old_ifs"
	live_status=$("$NDS_HELPER" live-clients 2>/dev/null || true)
	json_init
	json_add_int active_accounts "${active_accounts:-0}"
	json_add_int active_sessions "${active_sessions:-0}"
	json_add_int seconds_used "${seconds_used:-0}"
	json_add_int bytes_up "${bytes_up:-0}"
	json_add_int bytes_down "${bytes_down:-0}"
	json_add_string opennds_live_status "$live_status"
	json_dump
}

rpc_account_status_list() {
	rows=$($ADMIN account-status-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array account_status
	old_ifs="$IFS"
	IFS='|'
	while read -r id username period_type period_start period_end time_limit_s seconds_used remaining_seconds upload_limit_b bytes_up remaining_up download_limit_b bytes_down remaining_down active_devices; do
		[ -n "$id" ] || continue
		json_add_object
		json_add_int id "$id"
		json_add_string username "$username"
		json_add_string period_type "$period_type"
		json_add_string period_start "$period_start"
		json_add_string period_end "$period_end"
		json_add_int time_limit_s "$time_limit_s"
		json_add_int seconds_used "$seconds_used"
		json_add_int remaining_seconds "$remaining_seconds"
		json_add_int upload_limit_b "$upload_limit_b"
		json_add_int bytes_up "$bytes_up"
		json_add_int remaining_up "$remaining_up"
		json_add_int download_limit_b "$download_limit_b"
		json_add_int bytes_down "$bytes_down"
		json_add_int remaining_down "$remaining_down"
		json_add_int active_devices "$active_devices"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_history_list() {
	rows=$($ADMIN history-list 2>/dev/null) || rpc_error database
	json_init
	json_add_array history
	old_ifs="$IFS"
	IFS='|'
	while read -r account_id username period_start period_end seconds_used bytes_up bytes_down closed; do
		[ -n "$account_id" ] || continue
		json_add_object
		json_add_int account_id "$account_id"
		json_add_string username "$username"
		json_add_string period_start "$period_start"
		json_add_string period_end "$period_end"
		json_add_int seconds_used "$seconds_used"
		json_add_int bytes_up "$bytes_up"
		json_add_int bytes_down "$bytes_down"
		json_add_int closed "$closed"
		json_close_object
	done <<EOF
$rows
EOF
	IFS="$old_ifs"
	json_close_array
	json_dump
}

rpc_template_list() {
	rows=$($TEMPLATE_HELPER list 2>/dev/null) || rpc_error templates
	active=$(uci -q get open-hotspot.global.active_template 2>/dev/null || printf 'arabic-rtl')
	json_init
	json_add_string active_template "$active"
	json_add_array templates
	while read -r name; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string name "$name"
		if [ "$name" = "$active" ]; then
			json_add_boolean active 1
		else
			json_add_boolean active 0
		fi
		json_close_object
	done <<EOF
$rows
EOF
	json_close_array
	json_dump
}

rpc_template_apply() {
	name="$1"
	case "$name" in english|arabic-rtl) ;; *) rpc_error validation ;; esac
	$TEMPLATE_HELPER apply "$name" >/dev/null 2>&1 || rpc_error template-apply
	uci set open-hotspot.global.active_template="$name" || rpc_error template-config
	uci commit open-hotspot || rpc_error template-config
	rpc_template_list
}

rpc_setup_base() {
	if /usr/lib/open-hotspot/setup.sh base >/dev/null 2>&1; then
		rpc_ok
	else
		rpc_error setup-failed
	fi
}

rpc_router_access_set() {
	mode="$1"
	network="$2"
	[ -n "$network" ] || rpc_error validation
	/usr/lib/open-hotspot/router-access.sh apply "$mode" "$network" >/dev/null 2>&1 || rpc_error router-access
	rpc_ok
}

rpc_session_restore_set() {
	mode="$1"
	case "$mode" in enabled|disabled) ;; *) rpc_error validation ;; esac
	/usr/lib/open-hotspot/session-restore.sh apply "$mode" >/dev/null 2>&1 ||
		rpc_error session-restore
	rpc_ok
}

rpc_voucher_generate() {
	count="$1"; profile_id="$2"; validity_seconds="$3"
	codes=$($ADMIN voucher-generate "$count" "$profile_id" "$validity_seconds" 2>/dev/null) || rpc_error validation
	json_init
	json_add_array codes
	while read -r code; do
		[ -n "$code" ] || continue
		json_add_string "" "$code"
	done <<EOF
$codes
EOF
	json_close_array
	json_dump
}

rpc_mutation() {
	command_name="$1"
	shift
	if "$ADMIN" "$command_name" "$@" >/dev/null 2>&1; then
		rpc_ok
	else
		rpc_error validation
	fi
}

case "${1:-}" in
	list)
		echo '{"profile_list":{},"profile_create":{"name":"","period_type":"","time_limit_s":0,"upload_limit_b":0,"download_limit_b":0,"upload_rate_kbps":0,"download_rate_kbps":0,"max_devices":1},"profile_update":{"id":0,"name":"","period_type":"","time_limit_s":0,"upload_limit_b":0,"download_limit_b":0,"upload_rate_kbps":0,"download_rate_kbps":0,"max_devices":1},"profile_delete":{"id":0},"account_list":{},"account_create":{"username":"","profile_id":0,"expires_at":"","pin":""},"account_update":{"id":0,"username":"","profile_id":0,"status":"active","expires_at":""},"account_renew":{"id":0},"account_set_pin":{"id":0,"pin":""},"account_delete":{"id":0},"device_list":{},"device_block":{"id":0},"device_unblock":{"id":0},"device_remove":{"id":0},"device_force_deauth":{"id":0},"device_reassign":{"id":0,"target_account_id":0},"voucher_list":{},"voucher_generate":{"count":1,"profile_id":0,"validity_seconds":3600},"voucher_revoke":{"id":0},"overview":{},"account_status_list":{},"history_list":{},"template_list":{},"template_apply":{"name":""},"setup_base":{},"router_access_set":{"mode":"deny","network":""},"session_restore_set":{"mode":"disabled"}}'
		;;
	call)
		method="${2:-}"
		input=$(cat)
		json_load "$input" || rpc_error invalid-json
		case "$method" in
			profile_list) rpc_profile_list ;;
			account_list) rpc_account_list ;;
			device_list) rpc_device_list ;;
			voucher_list) rpc_voucher_list ;;
			overview) rpc_overview ;;
			account_status_list) rpc_account_status_list ;;
			history_list) rpc_history_list ;;
			template_list) rpc_template_list ;;
			template_apply)
				json_get_var name name
				rpc_template_apply "$name"
				;;
			setup_base) rpc_setup_base ;;
			router_access_set)
				json_get_var mode mode
				json_get_var network network
				rpc_router_access_set "$mode" "$network"
				;;
			session_restore_set)
				json_get_var mode mode
				rpc_session_restore_set "$mode"
				;;
			profile_create|profile_update)
				json_get_var name name
				json_get_var period period_type
				json_get_var time_limit time_limit_s
				json_get_var upload_limit upload_limit_b
				json_get_var download_limit download_limit_b
				json_get_var upload_rate upload_rate_kbps
				json_get_var download_rate download_rate_kbps
				json_get_var max_devices max_devices
				if [ "$method" = profile_create ]; then
					rpc_mutation profile-create "$name" "$period" "$time_limit" "$upload_limit" "$download_limit" "$upload_rate" "$download_rate" "$max_devices"
				else
					json_get_var id id
					rpc_mutation profile-update "$id" "$name" "$period" "$time_limit" "$upload_limit" "$download_limit" "$upload_rate" "$download_rate" "$max_devices"
				fi
				;;
			profile_delete|account_delete)
				json_get_var id id
				[ "$method" = profile_delete ] && command_name=profile-delete || command_name=account-delete
				rpc_mutation "$command_name" "$id"
				;;
			device_block|device_unblock|device_remove|device_force_deauth)
			json_get_var id id
			case "$method" in
				device_block) command_name=device-block ;;
				device_unblock) command_name=device-unblock ;;
				device_remove) command_name=device-remove ;;
				device_force_deauth) command_name=device-force-deauth ;;
			esac
				rpc_mutation "$command_name" "$id"
				;;
			device_reassign)
				json_get_var id id
				json_get_var target_account_id target_account_id
				rpc_mutation device-reassign "$id" "$target_account_id"
				;;
			voucher_generate)
				json_get_var count count
				json_get_var profile_id profile_id
				json_get_var validity_seconds validity_seconds
				rpc_voucher_generate "$count" "$profile_id" "$validity_seconds"
				;;
			voucher_revoke)
				json_get_var id id
				rpc_mutation voucher-revoke "$id"
				;;
			account_create)
				json_get_var username username
				json_get_var profile_id profile_id
				json_get_var expires_at expires_at
				json_get_var pin pin
				if printf '%s\n' "$pin" | "$ADMIN" account-create "$username" "$profile_id" "$expires_at" >/dev/null 2>&1; then rpc_ok; else rpc_error validation; fi
				;;
			account_update)
				json_get_var id id
				json_get_var username username
				json_get_var profile_id profile_id
				json_get_var status status
				json_get_var expires_at expires_at
				rpc_mutation account-update "$id" "$username" "$profile_id" "$status" "$expires_at"
				;;
			account_renew)
				json_get_var id id
				rpc_mutation account-renew "$id"
				;;
			account_set_pin)
				json_get_var id id
				json_get_var pin pin
				if printf '%s\n' "$pin" | "$ADMIN" account-set-pin "$id" >/dev/null 2>&1; then rpc_ok; else rpc_error validation; fi
				;;
			*) rpc_error unknown-method ;;
		esac
		;;
	*) exit 2 ;;
esac
