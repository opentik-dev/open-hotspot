config manager 'global'
	option check_interval    '300'
	option default_profile   '1'
	option active_template   'arabic-rtl'
	option history_retention '90'
	option log_retention_kb  '256'
	option pin_iterations    '100000'
	option setup_state       'new'
	option setup_last_error  ''
	option fas_mode          'local-level1'
	option fas_port          '2080'
	option fas_path          '/nds/fas.php'
	option local_fas_enabled '0'
	option session_restore   'disabled'
	option client_network    ''
	option client_router_access 'deny'
	# `protected` refuses captive activation on the management/service bridge.
	# Select `isolated` only after a separate captive bridge exists. The temporary
	# profile is deliberately not a default: it requires a future expiry and an
	# explicit risk acknowledgement on the router.
	option captive_plane_profile 'protected'
	option captive_plane_temporary_until ''
	option captive_plane_temporary_ack ''

# Disabled by default. This is configuration for a future, separately verified
# Family Captive plane; it does not create a bridge, SSID, firewall policy, or
# second openNDS daemon on its own.
config family_captive 'family_captive'
	option state 'disabled'
	option device ''
	option network ''
	option enforcement_adapter ''
