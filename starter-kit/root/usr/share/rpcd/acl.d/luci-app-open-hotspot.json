{
	"luci-app-open-hotspot": {
		"description": "Grant access to Open-HotSpot",
		"read": {
			"uci": [ "open-hotspot", "opennds" ],
			"ubus": { "open_hotspot": [ "profile_list", "account_list", "device_list", "voucher_list" ] },
			"file": { "/etc/open-hotspot/hotspot.db": [ "read" ] }
		},
		"write": {
			"uci": [ "open-hotspot", "opennds" ],
			"ubus": { "open_hotspot": [ "profile_create", "profile_update", "profile_delete", "account_create", "account_update", "account_set_pin", "account_delete", "device_block", "device_unblock", "device_remove", "voucher_generate", "voucher_revoke" ] },
			"file": { "/etc/open-hotspot/hotspot.db": [ "read", "write" ] }
		}
	}
}
